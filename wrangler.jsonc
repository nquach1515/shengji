// Cloudflare deploy for the game site (the relay has its own config in relay/wrangler.toml).
// Build with `npm run build`, then `npx wrangler deploy` uploads dist/ and site/worker.js, which passes /room/*
// (multiplayer) to the relay Worker so the site and the game connection share one hostname.
{
  "name": "shengji",
  "main": "site/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // the main page goes through site/worker.js (invite links get their own link preview); everything else is served
    // straight from dist/ as before, and paths with no file (/join, /room, the iOS link file) reach the Worker anyway
    "run_worker_first": ["/", "/index.html"]
  },
  "services": [{ "binding": "RELAY", "service": "shengji-relay" }]
}
