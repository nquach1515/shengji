<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: invite links to shengji-tractor.com open the app (site/worker.js serves the association file) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:shengji-tractor.com</string>
	</array>
</dict>
</plist>
